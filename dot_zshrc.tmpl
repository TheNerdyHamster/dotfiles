source_if_exists () {
	if test -r "$1"; then
		source "$1"
	fi
}

# Source
source_if_exists $HOME/.zsh/zinit
source_if_exists $HOME/.zsh/aliases
source_if_exists $HOME/.zsh/history

# Autoload 
autoload -U zmv
autoload -U promptinit && promptinit
autoload -U colors && colors
autoload -U compinit && compinit

# Export
export EDITOR=nvim
export VISUAL=nvim

# Keybindings
bindkey -e

# Completion
source_if_exists $HOME/.zsh/completion

zinit cdreplay -q

glogin() {
 glab auth login \
	 --token $(bw get item 9b555ed2-cfeb-4e5c-a3a4-b296014a7df9 | jq -r '.fields[] | select(.name == "token")'.value) \
	 --git-protocol ssh \
	 --api-protocol https
}

httpcode () {
 if [[ $# -ne 1 ]]; then
	 echo "Usage: $0 <number>"
	 return 1
 fi
 if [[ $1 =~ ^[0-9]{3}$ ]] || [[ $1 -ge 1 && $1 -le 999 ]]; then
	 open https://http.cat/$1
 else
	 echo "Invalid input: $1"
	 return 1
 fi
}


# Shell integrations
eval "$(fzf --zsh)"
eval "$(starship init zsh)"
source <(glab completion -s zsh)
