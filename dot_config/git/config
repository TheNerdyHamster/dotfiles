[includeIf "gitdir:~/Documents/code/gitlab.com/"]
    path = ~/.config/git/gitlab
[includeIf "gitdir:~/Documents/code/github.com/"]
    path = ~/.config/git/github
[includeIf "gitdir:~/.local/share/chezmoi/"]
    path = ~/.config/git/github

[aliases]
	a = "add"
	al = "add ."
	ap = "add -p"
	br = "branch"
	cane = "commit --amend --no-edit"
	cm = "commit"
	co = "checkout"
	d = "diff"
	last = "log -1 HEAD"
	lo = "log --oneline -n 10"
	loa = "log --oneline --all --decorate --graph"
	patch = "!git --no-pager diff --no-color"
	pmd = "push -o merge_request.create -o merge_request.draft"
	pms = "push -o merge_request.create"
	pr = "pull --rebase"
	pu = "!git push -u origin `git symbolic-ref --short HEAD`"
	rh = "reset --hard"
	s = "status"
	track = "!git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`"

[core]
	autocrlf = "input"
	editor = "nvim"

[core "color"]
	branch = "auto"
	diff = "auto"
	status = "auto"
	ui = true

[core "init"]
	defaultBranch = "main"

[core "merge"]
	conflictstyle = "zdiff3"

[core "status"]
	submodulesummary = true

[delta]
	enable = true

[delta "options"]
	dark = true
	line-numbers-minus-style = "#914c54"
	line-numbers-plus-style = "#449dab"
	line-numbers-zero-style = "#3b4261"
	minus-emph-style = "syntax #713137"
	minus-empty-line-marker-style = "syntax #37222c"
	minus-non-emph-style = "syntax #37222c"
	minus-style = "syntax #37222c"
	navigate = true
	plus-emph-style = "syntax #2c5a66"
	plus-empty-line-marker-style = "syntax #20303b"
	plus-non-emph-style = "syntax #20303b"
	plus-style = "syntax #20303b"

